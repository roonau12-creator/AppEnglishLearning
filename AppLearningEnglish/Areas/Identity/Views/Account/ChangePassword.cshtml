@model AppLearningEnglish.Models.ViewModels.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đổi mật khẩu";
}
<div class="auth-form-card mx-auto" style="max-width:560px">
    <h2>Đổi mật khẩu</h2>
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
            <input asp-for="CurrentPassword" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
            <input asp-for="NewPassword" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Xác nhận</label>
            <input asp-for="ConfirmPassword" class="form-control" />
        </div>
        <button class="btn btn-primary" type="submit">Cập nhật</button>
    </form>
</div>
