@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="auth-split auth-split-single">
    <section class="auth-form-panel">
        <div class="auth-form-card text-center">
            <span class="auth-logo-mark mx-auto mb-3">
                <i class="bi bi-shield-exclamation"></i>
            </span>
            <h2>Không có quyền truy cập</h2>
            <p class="auth-subtitle">
                Bạn không được phép xem trang này. Hãy đăng nhập bằng tài khoản phù hợp hoặc quay lại trang chủ.
            </p>
            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="auth-submit">
                Về trang chủ
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </section>
</div>
