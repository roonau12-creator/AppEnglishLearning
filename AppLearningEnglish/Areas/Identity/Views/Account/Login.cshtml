@model AppLearningEnglish.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-split">
    <section class="auth-visual">
        <a class="auth-logo" asp-area="Customer" asp-controller="Home" asp-action="Index">
            <span class="auth-logo-mark">
                <i class="bi bi-translate"></i>
            </span>
            AppLearningEnglish
        </a>

        <div class="auth-visual-copy">
            <span class="auth-badge">Học tiếng Anh mỗi ngày</span>
            <h1>Tiếp tục hành trình học tiếng Anh</h1>
            <p>
                Từ vựng, nghe và bài tập được thiết kế để bạn tiến bộ mỗi ngày.
            </p>
        </div>

        <ul class="auth-highlights">
            <li>
                <i class="bi bi-book"></i>
                <span>Học từ vựng kèm phát âm và ví dụ</span>
            </li>
            <li>
                <i class="bi bi-headphones"></i>
                <span>Luyện nghe với audio và transcript</span>
            </li>
            <li>
                <i class="bi bi-pencil-square"></i>
                <span>Làm bài tập để củng cố kiến thức</span>
            </li>
        </ul>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form-card">
            <p class="auth-kicker">Chào mừng trở lại</p>
            <h2>Đăng nhập</h2>
            <p class="auth-subtitle">Nhập email và mật khẩu để tiếp tục học.</p>

            <form asp-area="Identity"
                  asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@returnUrl"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                <div class="auth-field">
                    <label asp-for="Email">Email</label>
                    <div class="auth-input">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email"
                               placeholder="you@example.com"
                               autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password">Mật khẩu</label>
                    <div class="auth-input">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password" />
                        <button type="button" class="auth-toggle-password" data-password-toggle aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="auth-row">
                    <label class="auth-check">
                        <input asp-for="RememberMe" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button type="submit" class="auth-submit">
                    Đăng nhập
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>
            <partial name="_ExternalLogins" />

                <p class="auth-switch">
                    <a asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword">
                        Quên mật khẩu?
                    </a>
                </p>
                <p class="auth-switch">
                Chưa có tài khoản?
                <a asp-area="Identity"
                   asp-controller="Account"
                   asp-action="Register"
                   asp-route-returnUrl="@returnUrl">
                    Đăng ký ngay
                </a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
