@{
    ViewData["Title"] = "Kiểm tra email";
}
<div class="auth-form-card mx-auto" style="max-width:640px">
    <h2>Đã tiếp nhận yêu cầu</h2>
    <p>Nếu email tồn tại, bạn sẽ nhận được liên kết đặt lại mật khẩu.</p>
    @if (ViewBag.EmailSent as bool? == true)
    {
        <div class="alert alert-success">
            Đã gửi email. Liên kết hết hạn sau 1 giờ.
        </div>
    }
    @if (ViewBag.ResetUrl is string resetUrl)
    {
        <div class="alert alert-info">
            SMTP chưa cấu hình nên email không gửi được.
            <a href="@resetUrl">Mở liên kết đặt lại mật khẩu</a>
        </div>
    }
    <a class="btn btn-primary" asp-action="Login">Về đăng nhập</a>
</div>
