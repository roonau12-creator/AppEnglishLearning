@model AppLearningEnglish.Models.ViewModels.GrammarTopicViewModel
@{
    ViewData["Title"] = "Luyện " + Model.Topic.Title;
}

<div class="container py-4" style="max-width:760px">
    <a asp-action="Study" asp-route-id="@Model.Topic.Id">Quay lại giải thích</a>
    <h1 class="h3 fw-bold mt-2">@Model.Topic.Title</h1>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-warning">Chủ điểm này chưa có câu hỏi.</div>
    }
    else
    {
        <form method="post">
            @Html.AntiForgeryToken()
            @foreach (var item in Model.Items)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <p class="fw-semibold">@item.QuestionText</p>
                        @foreach (var option in item.Options)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="answers[@item.QuestionId]"
                                       value="@option"
                                       id="g-@item.QuestionId-@option.GetHashCode()"
                                       @(string.Equals(item.UserAnswer, option, StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                <label class="form-check-label" for="g-@item.QuestionId-@option.GetHashCode()">@option</label>
                            </div>
                        }
                        @if (item.IsCorrect != null)
                        {
                            <div class="mt-2 alert @(item.IsCorrect == true ? "alert-success" : "alert-warning") mb-0">
                                @(item.IsCorrect == true ? "Đúng." : $"Sai. Đáp án: {item.Answer}")
                                @if (!string.IsNullOrWhiteSpace(item.Explanation))
                                {
                                    <div class="small mt-1">@item.Explanation</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            @if (!Model.CorrectCount.HasValue)
            {
                <button class="btn btn-primary" type="submit">Nộp bài</button>
            }
            else
            {
                <div class="alert alert-info">Đúng @Model.CorrectCount / @Model.Items.Count</div>
                <a class="btn btn-outline-primary" asp-action="Index">Chủ điểm khác</a>
            }
        </form>
    }
</div>
