@model AppLearningEnglish.Models.Achievement

@{
    ViewData["Title"] = Model.Name;

    bool unlocked =
        ViewBag.Unlocked ?? false;

    int points =
        ViewBag.Points ?? 0;

    int progress = 0;

    if (Model.RequiredPoints > 0)
    {
        progress =
            (int)Math.Min(
                100,
                Math.Round(
                    (decimal)points
                    / Model.RequiredPoints
                    * 100));
    }
    else
    {
        progress = 100;
    }
}

<div class="container py-5">

    <div class="mb-4">

        <a asp-area="Customer"
           asp-controller="Achievement"
           asp-action="Index"
           class="text-decoration-none">

            <i class="bi bi-arrow-left"></i>

            My Achievements

        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center p-5">

                    @if (!string.IsNullOrEmpty(
                        Model.IconUrl))
                    {
                        <img src="@Model.IconUrl"
                             width="130"
                             height="130"
                             class="rounded-circle mb-4"
                             style="object-fit:cover;" />
                    }
                    else
                    {
                        <div class="display-1 mb-4">

                            @(unlocked ? "🏆" : "🔒")

                        </div>
                    }

                    <h1 class="fw-bold">

                        @Model.Name

                    </h1>

                    <p class="text-muted fs-5">

                        @Model.Description

                    </p>

                    <hr />

                    @if (unlocked)
                    {
                        <div class="alert alert-success">

                            <h4 class="fw-bold">

                                🎉 Achievement Unlocked!

                            </h4>

                            <p class="mb-0">

                                Chúc mừng! Bạn đã đạt
                                thành tựu này.

                            </p>

                        </div>
                    }
                    else
                    {
                        <h5 class="fw-bold mb-3">

                            Unlock Progress

                        </h5>

                        <div class="d-flex
                                    justify-content-between
                                    mb-2">

                            <span>
                                Your Points
                            </span>

                            <strong>
                                @points
                            </strong>

                        </div>

                        <div class="d-flex
                                    justify-content-between
                                    mb-2">

                            <span>
                                Required Points
                            </span>

                            <strong>
                                @Model.RequiredPoints
                            </strong>

                        </div>

                        <div class="progress"
                             style="height:15px">

                            <div class="progress-bar"
                                 style="width:@progress%">

                                @progress%

                            </div>

                        </div>

                        <p class="text-muted mt-3">

                            Cần thêm

                            <strong>
                                @(Math.Max(
                                    0,
                                    Model.RequiredPoints
                                    - points))
                            </strong>

                            điểm để mở khóa.

                        </p>
                    }

                    <a asp-area="Customer"
                       asp-controller="Achievement"
                       asp-action="Index"
                       class="btn btn-primary mt-3">

                        Back to Achievements

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>