@model AppLearningEnglish.Models.ForumPost
@{
    ViewData["Title"] = Model.Title;
    var isFollowing = ViewBag.IsFollowing as bool? == true;
}
<div class="container py-4" style="max-width:800px">
    <a asp-action="Index">Diễn đàn</a>
    <h1 class="fw-bold mt-2">@Model.Title</h1>
    <p class="text-muted">@(Model.ApplicationUser?.FullName ?? Model.ApplicationUser?.Email)</p>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body" style="white-space:pre-wrap">@Model.Body</div></div>
    <div class="d-flex gap-2 mb-4">
        <form asp-action="Like" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-outline-primary" type="submit">👍 @Model.LikeCount</button>
        </form>
        <form asp-action="Follow" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.ApplicationUserId" />
            <button class="btn btn-outline-secondary" type="submit">@(isFollowing ? "Bỏ theo dõi" : "Theo dõi")</button>
        </form>
    </div>
    <h2 class="h5">Bình luận</h2>
    @foreach (var comment in Model.Comments.OrderBy(x => x.CreatedAt))
    {
        <div class="border-bottom py-2">
            <strong>@(comment.ApplicationUser?.FullName ?? "Học viên")</strong>
            <div>@comment.Body</div>
        </div>
    }
    <form asp-action="Comment" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <textarea name="body" class="form-control mb-2" rows="3" required></textarea>
        <button class="btn btn-primary" type="submit">Gửi</button>
    </form>
</div>
