@model AppLearningEnglish.Models.ViewModels.ExerciseResultReviewViewModel

@{
    ViewData["Title"] = "Exercise Result";
    var attempt = Model.Attempt;
    decimal score = attempt.Score;
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold">Exercise Completed</h1>
        <div class="display-4 fw-bold text-primary">@score%</div>
        <p class="text-muted">@attempt.CorrectAnswers / @attempt.TotalQuestions câu đúng</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            @foreach (var question in Model.Questions)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <strong>@question.QuestionText</strong>
                        @if (question.IsFillBlank)
                        {
                            <div class="mt-3">
                                <div>
                                    Bạn trả lời:
                                    <span class="@(question.IsCorrect ? "text-success fw-semibold" : "text-danger")">
                                        @(string.IsNullOrWhiteSpace(question.UserText)
                                            ? "(bỏ trống)"
                                            : question.UserText)
                                    </span>
                                    @if (question.IsCorrect)
                                    {
                                        <span class="badge bg-success">Đúng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Sai</span>
                                    }
                                </div>
                                @if (!question.IsCorrect)
                                {
                                    <div class="text-success">
                                        Đáp án: <strong>@question.CorrectText</strong>
                                    </div>
                                }
                            </div>
                        }
                        @if (!question.IsFillBlank)
                        {
                            <ul class="list-unstyled mt-3 mb-0">
                                @foreach (var answer in question.Answers)
                                {
                                    var css = answer.IsCorrect ? "text-success fw-semibold" :
                                        answer.IsSelected ? "text-danger" : "text-muted";
                                    <li class="@css">
                                        @if (answer.IsSelected) { <i class="bi bi-arrow-right-short"></i> }
                                        @answer.AnswerText
                                        @if (answer.IsCorrect) { <span class="badge bg-success">Đúng</span> }
                                        else if (answer.IsSelected) { <span class="badge bg-danger">Bạn chọn</span> }
                                    </li>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrWhiteSpace(question.Explanation))
                        {
                            <p class="small text-muted mt-2 mb-0">@question.Explanation</p>
                        }
                    </div>
                </div>
            }

            <div class="d-flex gap-2 flex-wrap">
                <a asp-area="Customer" asp-controller="Exercise" asp-action="Start" asp-route-id="@attempt.ExerciseId" class="btn btn-primary">Làm lại</a>
                <a asp-area="Customer" asp-controller="Exercise" asp-action="History" asp-route-exerciseId="@attempt.ExerciseId" class="btn btn-outline-secondary">History</a>
                @if (Model.LessonId.HasValue)
                {
                    <a asp-area="Customer" asp-controller="Lesson" asp-action="Details" asp-route-id="@Model.LessonId" class="btn btn-outline-primary">Về bài học</a>
                }
            </div>
        </div>
    </div>
</div>
