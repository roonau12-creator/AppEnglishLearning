@model IEnumerable<AppLearningEnglish.Models.ExerciseAttempt>

@{
    ViewData["Title"] = "My Exercise History";
}

<div class="container py-5">

    <div class="mb-4">

        <h1 class="fw-bold">

            <i class="bi bi-bar-chart"></i>

            My Exercise History

        </h1>

        <p class="text-muted">

            Tất cả lịch sử làm bài của bạn.

        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">

            Bạn chưa làm Exercise nào.

        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="fw-bold">

                                @item.Exercise?.Type

                            </h5>

                            <div class="display-6 fw-bold text-primary">

                                @item.Score%

                            </div>

                            <p class="text-muted">

                                @item.CorrectAnswers /
                                @item.TotalQuestions
                                correct

                            </p>

                            <p class="small text-muted">

                                @item.StartedAt.ToLocalTime()

                            </p>

                            <a asp-area="Customer"
                               asp-controller="Exercise"
                               asp-action="Result"
                               asp-route-attemptId="@item.Id"
                               class="btn btn-outline-primary w-100">

                                View Result

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>