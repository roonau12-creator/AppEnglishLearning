@model AppLearningEnglish.Models.ViewModels.DailyStreakVM

@{
    ViewData["Title"] = "Study History";
}

<div class="container py-5">

    <div class="d-flex
                justify-content-between
                align-items-center
                mb-5">

        <div>

            <span class="section-label">
                LEARNING ACTIVITY
            </span>

            <h1 class="fw-bold mt-2">

                📜 Study History

            </h1>

            <p class="text-muted">

                Lịch sử học tập của bạn.

            </p>

        </div>


        <a asp-area="Customer"
           asp-controller="Streak"
           asp-action="Index"
           class="btn btn-outline-primary">

            <i class="bi bi-arrow-left"></i>

            Back to Streak

        </a>

    </div>


    <!-- STATISTICS -->

    <div class="row g-4 mb-5">

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon">
                    🔥
                </div>

                <div>

                    <span>
                        Current Streak
                    </span>

                    <strong>
                        @Model.CurrentStreak days
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon">
                    🏆
                </div>

                <div>

                    <span>
                        Longest Streak
                    </span>

                    <strong>
                        @Model.LongestStreak days
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon">
                    ⏱️
                </div>

                <div>

                    <span>
                        Total Study
                    </span>

                    <strong>
                        @Model.TotalStudyMinutes min
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- HISTORY TABLE -->

    <div class="card custom-card">

        <div class="card-body p-0">

            @if (!Model.History.Any())
            {
                <div class="empty-history p-5">

                    <div>
                        📚
                    </div>

                    <h4>
                        No study history
                    </h4>

                    <p>
                        Bạn chưa có hoạt động học tập.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                  table-hover
                                  align-middle
                                  mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    Date
                                </th>

                                <th>
                                    Study Time
                                </th>

                                <th>
                                    Points
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item
                                in Model.History)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <strong>

                                            @item.StudyDate.ToString("dd/MM/yyyy")

                                        </strong>

                                    </td>


                                    <td>

                                        <span class="time-badge">

                                            ⏱️
                                            @item.MinutesStudied
                                            minutes

                                        </span>

                                    </td>


                                    <td>

                                        <span class="point-badge">

                                            ⭐
                                            +@item.PointsEarned

                                        </span>

                                    </td>


                                    <td>

                                        <span class="badge
                                                     bg-success">

                                            ✓ Studied

                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>