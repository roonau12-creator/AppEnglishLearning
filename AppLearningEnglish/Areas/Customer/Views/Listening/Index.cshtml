@model IEnumerable<AppLearningEnglish.Models.ListeningLesson>

@{
    ViewData["Title"] = "Listening";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">
            <i class="bi bi-headphones"></i>
            Listening
        </h1>
        <p class="text-muted">Chọn bài nghe để luyện audio, transcript và câu hỏi.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Chưa có bài listening công khai.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <span class="badge bg-success mb-2">Listening</span>
                            <h4 class="fw-bold">@(item.Lesson?.Title ?? "Bài nghe")</h4>
                            <p class="text-muted">@(item.Lesson?.Course?.Name)</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Customer"
                   asp-controller="Listening"
                   asp-action="Play"
                   asp-route-lessonId="@item.LessonId"
                   class="btn btn-success w-100">
                    <i class="bi bi-play-fill"></i>
                    Bắt đầu nghe
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-controller="Account"
                   asp-action="Login"
                   asp-route-returnUrl="@Url.Action("Play", "Listening", new { area = "Customer", lessonId = item.LessonId })"
                   class="btn btn-success w-100">
                    Đăng nhập để nghe
                </a>
            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
