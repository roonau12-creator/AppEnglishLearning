@model AppLearningEnglish.Models.ViewModels.ListeningPlayViewModel

@{
    ViewData["Title"] = Model.Lesson.Title;
}

<div class="container py-4">
    <a asp-area="Customer"
       asp-controller="Lesson"
       asp-action="Details"
       asp-route-id="@Model.Lesson.Id"
       class="text-decoration-none">
        <i class="bi bi-arrow-left"></i>
        Quay lại bài học
    </a>

    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body p-4 p-lg-5">
            <span class="badge bg-success mb-2">Listening</span>
            <h1 class="fw-bold">@Model.Lesson.Title</h1>
            <p class="text-muted">Nghe audio, mở transcript nếu cần, rồi trả lời câu hỏi.</p>

            <div class="listening-player mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.ListeningLesson.VideoUrl))
                {
                    <div class="ratio ratio-16x9 mb-3">
                        <iframe src="@Model.ListeningLesson.VideoUrl" allowfullscreen title="Video bài nghe"></iframe>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ListeningLesson.AudioUrl))
                {
                    <audio id="listeningAudio" controls class="w-100">
                        <source src="@Model.ListeningLesson.AudioUrl" type="audio/mpeg" />
                    </audio>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <label class="small mb-0">Tốc độ</label>
                        <input type="range" id="audioRate" min="0.5" max="1.5" step="0.25" value="1" />
                        <span id="audioRateLabel">1x</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary accent-btn" data-lang="en-US">US</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary accent-btn" data-lang="en-GB">UK</button>
                    </div>
                }
                <button type="button"
                        class="btn btn-outline-success mt-3"
                        id="speakTranscript"
                        data-transcript="@Model.ListeningLesson.Transcript">
                    <i class="bi bi-volume-up"></i>
                    Đọc transcript
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ListeningLesson.Transcript))
            {
                <button class="btn btn-link px-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#transcriptBox">
                    Hiện / ẩn transcript
                </button>
                <div class="collapse" id="transcriptBox">
                    <div class="alert alert-light border">
                        @{
                            var sentences = (Model.ListeningLesson.Transcript ?? "")
                                .Split(new[] { '.', '?', '!' }, StringSplitOptions.RemoveEmptyEntries);
                        }
                        @foreach (var sentence in sentences)
                        {
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <span>@sentence.Trim().</span>
                                <button type="button" class="btn btn-sm btn-outline-success speak-sentence" data-text="@sentence.Trim()">
                                    Nghe câu
                                </button>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ListeningLesson.TranslationVi))
                    {
                        <div class="alert alert-info">@Model.ListeningLesson.TranslationVi</div>
                    }
                </div>
            }

            <hr />

            <h2 class="h4 fw-bold">Câu hỏi</h2>

            @if (!Model.Questions.Any())
            {
                <div class="alert alert-info">Bài nghe này chưa có câu hỏi.</div>
            }
            else
            {
                <form asp-area="Customer" asp-controller="Listening" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />

                    @{
                        var index = 1;
                    }
                    @foreach (var question in Model.Questions)
                    {
                        var options = question.GetOptions();
                        var isChoice =
                            question.QuestionType == ListeningQuestionTypes.MultipleChoice &&
                            options.Count > 0;
                        var isGap = question.QuestionType == ListeningQuestionTypes.TranscriptGap;
                        var isSentence = question.QuestionType == ListeningQuestionTypes.Sentence;
                        var isDictation = question.QuestionType == ListeningQuestionTypes.Dictation;
                        var typeLabel = question.QuestionType switch
                        {
                            ListeningQuestionTypes.TranscriptGap => "Điền chỗ trống",
                            ListeningQuestionTypes.Sentence => "Nghe từng câu",
                            ListeningQuestionTypes.Dictation => "Chính tả",
                            ListeningQuestionTypes.MultipleChoice => "Chọn đáp án",
                            _ => "Điền chữ"
                        };

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold mb-0">
                                    @index.
                                    @if (!isGap)
                                    {
                                        @question.Question
                                    }
                                    else
                                    {
                                        <text>Điền từ còn thiếu trong transcript</text>
                                    }
                                </label>
                                <span class="badge text-bg-light">@typeLabel</span>
                            </div>

                            @if (isSentence || isDictation)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-success mb-2 speak-sentence"
                                        data-text="@question.Answer">
                                    <i class="bi bi-play-circle"></i>
                                    Nghe câu này
                                </button>
                            }

                            @if (isChoice)
                            {
                                foreach (var option in options)
                                {
                                    var optionId = $"lq_{question.Id}_{option.GetHashCode()}";
                                    <div class="form-check border rounded p-2 mb-2">
                                        <input class="form-check-input"
                                               type="radio"
                                               id="@optionId"
                                               name="answers[@question.Id]"
                                               value="@option"
                                               required />
                                        <label class="form-check-label w-100" for="@optionId">
                                            @option
                                        </label>
                                    </div>
                                }
                            }
                            else if (isGap)
                            {
                                var gapParts = question.Question.Split("___");
                                <div class="alert alert-light border d-flex flex-wrap align-items-center gap-2 mb-0">
                                    @for (var partIndex = 0; partIndex < gapParts.Length; partIndex++)
                                    {
                                        <span>@gapParts[partIndex]</span>
                                        if (partIndex < gapParts.Length - 1)
                                        {
                                            <input type="text"
                                                   name="answers[@question.Id]"
                                                   class="form-control d-inline-block"
                                                   style="width:160px"
                                                   placeholder="điền từ"
                                                   required />
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <input type="text"
                                       name="answers[@question.Id]"
                                       class="form-control"
                                       placeholder="@(isDictation ? "Gõ đúng chính tả câu bạn nghe" : "Nhập câu trả lời")"
                                       required />
                            }
                        </div>
                        index++;
                    }

                    <button type="submit" class="btn btn-success w-100">
                        Nộp bài
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function speakEnglish(text) {
            if (!text || !window.speechSynthesis) {
                return;
            }
            window.speechSynthesis.cancel();
            var utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = window._ttsLang || "en-US";
            window.speechSynthesis.speak(utterance);
        }
        document.querySelectorAll(".accent-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                window._ttsLang = this.getAttribute("data-lang") || "en-US";
            });
        });

        document.getElementById("speakTranscript")?.addEventListener("click", function () {
            speakEnglish(this.getAttribute("data-transcript") || "");
        });

        document.querySelectorAll(".speak-sentence").forEach(function (button) {
            button.addEventListener("click", function () {
                speakEnglish(this.getAttribute("data-text") || "");
            });
        });

        var audio = document.getElementById("listeningAudio");
        var rate = document.getElementById("audioRate");
        var label = document.getElementById("audioRateLabel");
        rate?.addEventListener("input", function () {
            if (audio) audio.playbackRate = parseFloat(this.value);
            if (label) label.textContent = this.value + "x";
        });
    </script>
}
