@model AppLearningEnglish.Models.ViewModels.LessonWordListViewModel

@{
    ViewData["Title"] = "Từ vựng bài học";
}

<div class="container py-4">
    <a asp-area="Customer"
       asp-controller="Lesson"
       asp-action="Details"
       asp-route-id="@Model.Lesson.Id"
       class="text-decoration-none">
        <i class="bi bi-arrow-left"></i>
        Quay lại bài học
    </a>

    <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
        <div>
            <h1 class="fw-bold">Từ vựng: @Model.Lesson.Title</h1>
            <p class="text-muted mb-0">Xem nghĩa, ví dụ rồi thêm vào sổ từ của bạn.</p>
        </div>
        <a asp-area="Customer" asp-controller="Vocabulary" asp-action="Index" class="btn btn-outline-primary">
            My Vocabulary
        </a>
    </div>

    @if (!Model.Words.Any())
    {
        <div class="alert alert-info">Bài học này chưa có từ vựng.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Words)
            {
                var word = item.Word;
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h3 class="fw-bold">@word.WordText</h3>
                                @if (!string.IsNullOrWhiteSpace(word.PartOfSpeech))
                                {
                                    <span class="badge bg-primary">@word.PartOfSpeech</span>
                                }
                            </div>
                            <p class="text-muted">@word.Pronunciation</p>

                            @if (!string.IsNullOrWhiteSpace(word.AudioUrl))
                            {
                                <audio controls class="w-100 mb-3">
                                    <source src="@word.AudioUrl" type="audio/mpeg" />
                                </audio>
                            }

                            @if (!string.IsNullOrWhiteSpace(word.Definition))
                            {
                                <p>@word.Definition</p>
                            }

                            @if (word.Meanings.Any())
                            {
                                <div class="mb-2">
                                    @foreach (var meaning in word.Meanings)
                                    {
                                        <div>
                                            <small class="text-muted text-uppercase">@meaning.Language</small>
                                            <strong>@meaning.Meaning</strong>
                                        </div>
                                    }
                                </div>
                            }

                            @if (word.Examples.Any())
                            {
                                <ul class="small mb-3">
                                    @foreach (var example in word.Examples)
                                    {
                                        <li>
                                            @example.EnglishSentence
                                            <div class="text-muted">@example.VietnameseMeaning</div>
                                        </li>
                                    }
                                </ul>
                            }

                            @if (item.IsSaved)
                            {
                                <span class="badge bg-success">Đã có trong sổ từ</span>
                            }
                            else
                            {
                                <form asp-area="Customer" asp-controller="Vocabulary" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="wordId" value="@word.Id" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Lesson", "Vocabulary", new { area = "Customer", lessonId = Model.Lesson.Id })" />
                                    <button type="submit" class="btn btn-primary w-100">
                                        Thêm vào My Vocabulary
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
