@{
    ViewData["Title"] = "Listening Questions";
    ViewData["Subtitle"] = "Câu hỏi kiểm tra bài nghe";
    ViewData["Icon"] = "bi-ear";
    ViewData["Tone"] = "sky";
    ViewData["ActionText"] = "Thêm Question";
    ViewData["ActionController"] = "ListeningQuestion";
}
<partial name="_AdminPageHead" />
<div class="admin-filter mb-4">
    <div class="admin-filter-label"><i class="bi bi-funnel"></i> Bộ lọc</div>
    <div class="row g-3">
        <div class="col-lg-5"><label class="form-label fw-semibold">Tìm kiếm</label><input id="searchInput" class="form-control" placeholder="Question hoặc Answer..." /></div>
        <div class="col-lg-5">
            <label class="form-label fw-semibold">Listening Lesson</label>
            <select id="listeningLessonFilter" class="form-select">
                <option value="">Tất cả Listening Lesson</option>
                @foreach (var item in ViewBag.ListeningLessons) { <option value="@item.Value">@item.Text</option> }
            </select>
        </div>
        <div class="col-lg-2 d-flex align-items-end"><button id="btnFilter" type="button" class="btn btn-dark w-100"><i class="bi bi-search"></i></button></div>
    </div>
</div>
<div class="card"><div class="card-header"><h5 class="mb-0 fw-bold">Danh sách Listening Questions</h5></div>
<div class="card-body"><table id="listeningQuestionTable" class="table table-hover align-middle w-100"><thead><tr><th>Listening</th><th>Question</th><th>Answer</th><th class="text-end">Action</th></tr></thead><tbody></tbody></table></div></div>
@section Scripts { <script src="~/js/listeningQuestion.js"></script> }
