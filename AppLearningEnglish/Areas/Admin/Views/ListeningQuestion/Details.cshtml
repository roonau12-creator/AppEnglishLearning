@model AppLearningEnglish.Models.ListeningQuestion
@{ ViewData["Title"] = "Listening Question"; }
<div class="admin-form-banner tone-sky">
    <div class="admin-form-icon"><i class="bi bi-ear"></i></div>
    <div>
        <h1 class="fw-bold">@(Model.ListeningLesson?.Lesson?.Title ?? "Listening")</h1>
        <p>@Model.QuestionType</p>
    </div>
</div>
<div class="card"><div class="card-body">
    @if (!string.IsNullOrWhiteSpace(Model.ListeningLesson?.AudioUrl))
    {
        <audio controls class="w-100 mb-3"><source src="@Model.ListeningLesson.AudioUrl" /></audio>
    }
    <div class="admin-detail-panel mb-3"><small class="text-muted">Question</small><h5 class="mt-1 mb-0">@Model.Question</h5></div>
    <div class="admin-detail-panel mb-4"><small class="text-muted">Answer</small><h5 class="mt-1 mb-0">@Model.Answer</h5></div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="ListeningQuestion" asp-action="Upsert" asp-route-id="@Model.Id">Sửa</a>
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="ListeningQuestion" asp-action="Index" asp-route-listeningLessonId="@Model.ListeningLessonId">Quay lại</a>
    </div>
</div></div>
