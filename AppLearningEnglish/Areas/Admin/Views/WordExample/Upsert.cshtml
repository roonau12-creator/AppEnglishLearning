@model AppLearningEnglish.Models.WordExample
@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Thêm Example" : "Sửa Example";
}
<div class="admin-form-banner tone-amber">
    <div class="admin-form-icon"><i class="bi bi-quote"></i></div>
    <div>
        <h1 class="fw-bold">@(isCreate ? "Thêm câu ví dụ" : "Chỉnh sửa câu ví dụ")</h1>
        <p>Một câu Anh ngắn và bản dịch tiếng Việt.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="card"><div class="card-body">
            <form asp-area="Admin" asp-controller="WordExample" asp-action="Upsert" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="WordId" class="form-label fw-semibold">Word</label>
                    <select asp-for="WordId" asp-items="ViewBag.Words" class="form-select"><option value="">-- Chọn Word --</option></select>
                    <span asp-validation-for="WordId" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="EnglishSentence" class="form-label fw-semibold">English Sentence</label>
                    <textarea asp-for="EnglishSentence" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="EnglishSentence" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="VietnameseMeaning" class="form-label fw-semibold">Vietnamese Meaning</label>
                    <textarea asp-for="VietnameseMeaning" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="VietnameseMeaning" class="text-danger"></span>
                </div>
                <div class="admin-preview mb-4">
                    <p id="englishPreview" class="mb-1">English sentence...</p>
                    <p id="vietnamesePreview" class="text-muted mb-0">Nghĩa tiếng Việt...</p>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="WordExample" asp-action="Index">Quay lại</a>
                    <button class="btn btn-primary" type="submit">@(isCreate ? "Thêm Example" : "Lưu thay đổi")</button>
                </div>
            </form>
        </div></div>
    </div>
    <div class="col-xl-4"><aside class="admin-aside"><h3>Ví dụ hay</h3><p class="mb-0">Câu ngắn, đúng ngữ pháp, sát nghĩa từ đang dạy.</p></aside></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $("#EnglishSentence").on("input", function () { $("#englishPreview").text($(this).val() || "English sentence..."); });
        $("#VietnameseMeaning").on("input", function () { $("#vietnamesePreview").text($(this).val() || "Nghĩa tiếng Việt..."); });
    </script>
}
