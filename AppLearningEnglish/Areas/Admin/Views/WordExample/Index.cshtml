@{
    ViewData["Title"] = "Word Examples";
    ViewData["Subtitle"] = "Câu ví dụ Anh – Việt";
    ViewData["Icon"] = "bi-quote";
    ViewData["Tone"] = "amber";
    ViewData["ActionText"] = "Thêm Example";
    ViewData["ActionController"] = "WordExample";
}
<partial name="_AdminPageHead" />
<div class="admin-filter mb-4">
    <div class="admin-filter-label"><i class="bi bi-funnel"></i> Bộ lọc</div>
    <div class="row g-3">
        <div class="col-lg-5"><label class="form-label fw-semibold">Tìm kiếm</label><input id="searchInput" class="form-control" placeholder="Câu ví dụ..." /></div>
        <div class="col-lg-5">
            <label class="form-label fw-semibold">Word</label>
            <select id="wordFilter" class="form-select">
                <option value="">Tất cả Word</option>
                @foreach (var word in ViewBag.Words) { <option value="@word.Value">@word.Text</option> }
            </select>
        </div>
        <div class="col-lg-2 d-flex align-items-end"><button id="btnFilter" type="button" class="btn btn-dark w-100"><i class="bi bi-search"></i></button></div>
    </div>
</div>
<div class="card"><div class="card-header"><h5 class="mb-0 fw-bold">Danh sách câu ví dụ</h5></div>
<div class="card-body"><table id="wordExampleTable" class="table table-hover align-middle w-100"><thead><tr><th>Word</th><th>English Sentence</th><th>Vietnamese Meaning</th><th class="text-end">Action</th></tr></thead><tbody></tbody></table></div></div>
@section Scripts { <script src="~/js/wordExample.js"></script> }
