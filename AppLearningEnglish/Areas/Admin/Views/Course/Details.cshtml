@model AppLearningEnglish.Models.Course
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = "Chi tiết khóa học";
}

<div class="admin-form-banner tone-sky">
    <div class="admin-form-icon"><i class="bi bi-collection-play-fill"></i></div>
    <div>
        <h1 class="fw-bold">@Model.Name</h1>
        <p>Level @Model.Level · @(Model.IsPublished ? "Đang mở" : "Bản nháp")</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                {
                    <img src="@Model.ThumbnailUrl" class="img-fluid rounded" style="width:100%;height:240px;object-fit:cover" />
                }
                else
                {
                    <div class="admin-preview d-flex align-items-center justify-content-center" style="height:240px">
                        <i class="bi bi-image fs-1 text-muted"></i>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <div class="admin-chip-row mb-3">
                    <span class="badge text-bg-primary">@Model.Level</span>
                    @if (Model.IsPublished)
                    {
                        <span class="badge text-bg-success">Published</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Draft</span>
                    }
                </div>
                <h6 class="fw-bold">Mô tả</h6>
                <p class="text-muted">@(Model.Description ?? "Chưa có mô tả.")</p>
                <div class="row">
                    <div class="col-md-6">
                        <small class="text-muted">Course ID</small>
                        <p class="fw-semibold">@Model.Id</p>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Created At</small>
                        <p class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary" asp-area="Admin" asp-controller="Course" asp-action="Upsert" asp-route-id="@Model.Id">
                        <i class="bi bi-pencil-square"></i> Sửa
                    </a>
                    <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Lesson" asp-action="Index" asp-route-courseId="@Model.Id">
                        <i class="bi bi-journal-richtext"></i> Quản lý Lesson
                    </a>
                    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Course" asp-action="Index">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
