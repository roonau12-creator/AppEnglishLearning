@model AppLearningEnglish.Models.PracticeAttempt
@{
    ViewData["Title"] = Model.Title;
}
<a asp-action="Index">Bài nói / viết</a>
<h1 class="h3 fw-bold mt-2">@Model.Title</h1>
<p class="text-muted">
    @(Model.ApplicationUser?.FullName ?? Model.ApplicationUser?.Email)
    · @(Model.Kind == "speaking" ? "Nói" : "Viết")
    · @Model.Score%
    · @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
</p>
<div class="card mb-3"><div class="card-body">
    <h2 class="h6">Đề / gợi ý</h2>
    <p class="mb-0">@(Model.Prompt ?? "—")</p>
</div></div>
<div class="card mb-3"><div class="card-body">
    <h2 class="h6">Câu mẫu</h2>
    <p class="mb-0">@(Model.Expected ?? "—")</p>
</div></div>
<div class="card mb-3"><div class="card-body">
    <h2 class="h6">Bài học viên</h2>
    <p class="mb-0">@(Model.UserAnswer ?? "—")</p>
</div></div>
<div class="card"><div class="card-body">
    <h2 class="h6">Nhận xét máy</h2>
    <p class="mb-0">@(Model.Feedback ?? "—")</p>
</div></div>
