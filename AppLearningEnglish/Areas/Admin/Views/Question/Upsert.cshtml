@model AppLearningEnglish.Models.Question
@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Thêm Question" : "Sửa Question";
}
<div class="admin-form-banner tone-violet">
    <div class="admin-form-icon"><i class="bi bi-question-circle-fill"></i></div>
    <div>
        <h1 class="fw-bold">@(isCreate ? "Thêm Question" : "Chỉnh sửa Question")</h1>
        <p>Viết câu hỏi và giải thích để học viên hiểu sau khi nộp.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="card"><div class="card-body">
            <form asp-area="Admin" asp-controller="Question" asp-action="Upsert" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="ExerciseId" class="form-label fw-semibold">Exercise</label>
                    <select asp-for="ExerciseId" asp-items="ViewBag.Exercises" class="form-select"><option value="">-- Chọn Exercise --</option></select>
                    <span asp-validation-for="ExerciseId" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="QuestionText" class="form-label fw-semibold">Question</label>
                    <textarea asp-for="QuestionText" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="QuestionText" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Explanation" class="form-label fw-semibold">Explanation</label>
                    <textarea asp-for="Explanation" class="form-control" rows="4"></textarea>
                </div>
                <div class="admin-preview mb-4">
                    <span class="badge text-bg-primary">Question</span>
                    <p id="questionPreview" class="fw-semibold mt-2 mb-2">Question...</p>
                    <p id="explanationPreview" class="text-muted mb-0">Explanation...</p>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Question" asp-action="Index">Quay lại</a>
                    <button class="btn btn-primary" type="submit">@(isCreate ? "Thêm Question" : "Lưu thay đổi")</button>
                </div>
            </form>
        </div></div>
    </div>
    <div class="col-xl-4"><aside class="admin-aside"><h3>Tiếp theo</h3><p class="mb-0">Thêm Answer và đánh dấu đúng một đáp án.</p></aside></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $("#QuestionText").on("input", function () { $("#questionPreview").text($(this).val() || "Question..."); });
        $("#Explanation").on("input", function () { $("#explanationPreview").text($(this).val() || "Explanation..."); });
    </script>
}
