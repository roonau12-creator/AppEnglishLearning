@model AppLearningEnglish.Models.Exercise
@{
    ViewData["Title"] = "Exercise";
    ViewData["Subtitle"] = "Chi tiết bài tập";
}

<div class="admin-form-banner tone-grape">
    <div class="admin-form-icon"><i class="bi bi-ui-checks"></i></div>
    <div>
        <h1 class="fw-bold">@(Model.Lesson?.Title ?? "Exercise")</h1>
        <p>@Model.Type · thứ tự @Model.ExerciseOrder</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="admin-detail-panel mb-3">
            <small class="text-muted">Đề bài</small>
            <h5 class="mb-0 mt-1">@Model.Question</h5>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Exercise" asp-action="Upsert" asp-route-id="@Model.Id">Sửa</a>
            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Question" asp-action="Index" asp-route-exerciseId="@Model.Id">Questions</a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Exercise" asp-action="Index" asp-route-lessonId="@Model.LessonId">Quay lại</a>
        </div>
    </div>
</div>
