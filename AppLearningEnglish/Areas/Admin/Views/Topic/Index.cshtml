@{
    ViewData["Title"] = "Topics";
    ViewData["Subtitle"] = "Chủ đề gom các khóa và bài học";
    ViewData["Icon"] = "bi-bookmark-star-fill";
    ViewData["Tone"] = "violet";
    ViewData["ActionText"] = "Thêm Topic";
    ViewData["ActionController"] = "Topic";
}

<partial name="_AdminPageHead" />

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Danh sách Topic</h5>
        <span class="badge text-bg-light">Catalog</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="topicTable" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Tên Topic</th>
                        <th>Mô tả</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/topic.js"></script>
}
