@model AppLearningEnglish.Models.GrammarTopic
@{
    ViewData["Title"] = Model.Title;
}
<div class="d-flex justify-content-between mb-3">
    <div>
        <a asp-action="Index">Chủ điểm</a>
        <h1 class="h3 fw-bold">@Model.Title</h1>
        <span class="badge bg-primary">@Model.Level</span>
    </div>
    <a class="btn btn-outline-primary" asp-action="Upsert" asp-route-id="@Model.Id">Sửa chủ điểm</a>
</div>
<pre class="bg-light p-3 rounded" style="white-space:pre-wrap">@Model.Explanation</pre>
<h2 class="h5 mt-4">Câu luyện</h2>
<table class="table">
    <thead><tr><th>Câu hỏi</th><th>Đáp án</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.QuestionText</td>
            <td>@item.Answer</td>
            <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem(@item.Id)"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    }
    </tbody>
</table>
<div class="card mt-3"><div class="card-body">
    <h3 class="h6">Thêm câu</h3>
    <form asp-action="AddItem" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="GrammarTopicId" value="@Model.Id" />
        <div class="row g-2">
            <div class="col-md-6"><input name="QuestionText" class="form-control" placeholder="Câu hỏi" required /></div>
            <div class="col-md-3"><input name="Options" class="form-control" placeholder="Lựa chọn a|b|c" /></div>
            <div class="col-md-2"><input name="Answer" class="form-control" placeholder="Đáp án" required /></div>
            <div class="col-md-1"><button class="btn btn-primary w-100" type="submit">Thêm</button></div>
            <div class="col-12"><input name="Explanation" class="form-control" placeholder="Giải thích" /></div>
        </div>
    </form>
</div></div>
@section Scripts {
<script>
    function deleteItem(id) {
        $.post("/Admin/GrammarTopic/DeleteItem", { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val() }, function (res) {
            if (res.success) location.reload();
            else Swal.fire({ icon: "error", title: res.message });
        });
    }
</script>
}
