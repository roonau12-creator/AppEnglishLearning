@model AppLearningEnglish.Models.GrammarTopic
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Sửa chủ điểm" : "Thêm chủ điểm";
}
<div class="admin-form-banner tone-violet">
    <div class="admin-form-icon"><i class="bi bi-spellcheck"></i></div>
    <div>
        <h1 class="fw-bold">@(isEdit ? "Chỉnh sửa chủ điểm" : "Tạo chủ điểm")</h1>
        <p>Học viên đọc giải thích rồi làm câu luyện.</p>
    </div>
</div>
<div class="card"><div class="card-body">
    <form asp-action="Upsert" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Tiêu đề</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Level" class="form-label">Trình độ</label>
                <select asp-for="Level" class="form-select">
                    <option>Beginner</option>
                    <option>Elementary</option>
                    <option>Intermediate</option>
                    <option>Advanced</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="SortOrder" class="form-label">Thứ tự</label>
                <input asp-for="SortOrder" type="number" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Explanation" class="form-label">Giải thích</label>
            <textarea asp-for="Explanation" class="form-control" rows="8"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Examples" class="form-label">Ví dụ</label>
            <textarea asp-for="Examples" class="form-control" rows="4"></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
            <button class="btn btn-primary" type="submit">@(isEdit ? "Cập nhật" : "Tạo mới")</button>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
