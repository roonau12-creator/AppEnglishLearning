@model AppLearningEnglish.Models.Lesson
@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Thêm Lesson" : "Sửa Lesson";
    ViewData["Subtitle"] = "Nội dung đọc, video và ngữ pháp";
}

<div class="admin-form-banner tone-pink">
    <div class="admin-form-icon"><i class="bi bi-journal-richtext"></i></div>
    <div>
        <h1 class="fw-bold">@(isCreate ? "Thêm Lesson" : "Chỉnh sửa Lesson")</h1>
        <p>Gắn Course + Topic, rồi viết nội dung học viên sẽ đọc.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Lesson" asp-action="Upsert" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="CourseId" class="form-label fw-semibold">Course</label>
                            <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                                <option value="">-- Chọn Course --</option>
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="TopicId" class="form-label fw-semibold">Topic</label>
                            <select asp-for="TopicId" asp-items="ViewBag.Topics" class="form-select">
                                <option value="">-- Chọn Topic --</option>
                            </select>
                            <span asp-validation-for="TopicId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold">Tên Lesson</label>
                        <input asp-for="Title" class="form-control" placeholder="Ví dụ: Greetings" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả nội dung Lesson..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Nội dung bài học</label>
                        <textarea asp-for="Content" class="form-control" rows="8" placeholder="Nội dung đọc cho học viên..."></textarea>
                    </div>
                    <div class="mb-4">
                        <label asp-for="VideoUrl" class="form-label fw-semibold">Video URL</label>
                        <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                    </div>
                    <div class="mb-4">
                        <label asp-for="GrammarNotes" class="form-label fw-semibold">Grammar notes</label>
                        <textarea asp-for="GrammarNotes" class="form-control" rows="4" placeholder="Ghi chú ngữ pháp..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="LessonOrder" class="form-label fw-semibold">Thứ tự</label>
                            <input asp-for="LessonOrder" type="number" min="1" class="form-control" />
                            <span asp-validation-for="LessonOrder" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold">Thời lượng</label>
                            <div class="input-group">
                                <input asp-for="DurationMinutes" type="number" min="1" class="form-control" />
                                <span class="input-group-text">phút</span>
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                            <label asp-for="IsPublished" class="form-check-label fw-semibold">Publish Lesson</label>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Lesson" asp-action="Index">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            @(isCreate ? "Tạo Lesson" : "Lưu thay đổi")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <aside class="admin-aside">
            <h3><i class="bi bi-list-check me-1"></i> Lộ trình bài</h3>
            <ul class="mb-0 ps-3">
                <li>Vocab → Listening → Exercise.</li>
                <li>Video YouTube sẽ nhúng trên trang học.</li>
                <li>Chỉ publish khi nội dung đã đủ 3 bước.</li>
            </ul>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
