@model AppLearningEnglish.Models.Lesson
@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = "Chi tiết bài học";
}

<div class="admin-form-banner tone-pink">
    <div class="admin-form-icon"><i class="bi bi-journal-richtext"></i></div>
    <div>
        <h1 class="fw-bold">@Model.Title</h1>
        <p>@(Model.IsPublished ? "Đã xuất bản" : "Bản nháp") · @Model.DurationMinutes phút</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="admin-stat"><small>Course</small><strong class="fs-5">@(Model.Course?.Name ?? "N/A")</strong></div></div>
    <div class="col-md-3"><div class="admin-stat"><small>Topic</small><strong class="fs-5">@(Model.Topic?.Name ?? "N/A")</strong></div></div>
    <div class="col-md-3"><div class="admin-stat"><small>Thứ tự</small><strong class="fs-5">@Model.LessonOrder</strong></div></div>
    <div class="col-md-3"><div class="admin-stat"><small>Thời lượng</small><strong class="fs-5">@Model.DurationMinutes phút</strong></div></div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="fw-bold">Mô tả</h5>
        <div class="admin-detail-panel">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả." : Model.Description)
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <h5 class="fw-bold mt-4">Nội dung</h5>
            <div class="admin-detail-panel">@Model.Content</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.GrammarNotes))
        {
            <h5 class="fw-bold mt-4">Grammar</h5>
            <div class="admin-detail-panel">@Model.GrammarNotes</div>
        }
        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Lesson" asp-action="Upsert" asp-route-id="@Model.Id">
                <i class="bi bi-pencil-square me-1"></i> Sửa
            </a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Lesson" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
</div>
