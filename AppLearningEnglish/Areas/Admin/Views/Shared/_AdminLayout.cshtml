@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayName = User.FindFirstValue("FullName") ?? User.Identity?.Name ?? "Admin";
    var initial = displayName.Trim().Length > 0 ? displayName.Trim()[0].ToString().ToUpperInvariant() : "A";
    bool Active(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.min.css" />
</head>
<body class="admin-shell">
    @Html.AntiForgeryToken()
    <div class="admin-app">
        <div class="admin-backdrop" data-admin-toggle></div>
        <aside class="admin-sidebar">
            <a class="admin-brand"
               asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">
                <span class="admin-brand-mark">
                    <i class="bi bi-translate"></i>
                </span>
                <span class="admin-brand-copy">
                    <strong>English Admin</strong>
                    <small>Điều hành lớp học</small>
                </span>
            </a>

            <div class="admin-nav-label">Tổng quan</div>
            <nav class="admin-nav">
                <a class="nav-link @(Active("Dashboard") ? "active" : null)"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
                <a class="nav-link @(Active("User") ? "active" : null)"
                   asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people-fill"></i> Học viên
                </a>
            </nav>

            <div class="admin-nav-label">Nội dung</div>
            <nav class="admin-nav">
                <a class="nav-link @(Active("Topic") ? "active" : null)"
                   asp-area="Admin" asp-controller="Topic" asp-action="Index">
                    <i class="bi bi-bookmark-star-fill"></i> Topics
                </a>
                <a class="nav-link @(Active("Course") ? "active" : null)"
                   asp-area="Admin" asp-controller="Course" asp-action="Index">
                    <i class="bi bi-collection-play-fill"></i> Courses
                </a>
                <a class="nav-link @(Active("Lesson") ? "active" : null)"
                   asp-area="Admin" asp-controller="Lesson" asp-action="Index">
                    <i class="bi bi-journal-richtext"></i> Lessons
                </a>
                <a class="nav-link @(Active("Word") || Active("WordMeaning") || Active("WordExample") ? "active" : null)"
                   asp-area="Admin" asp-controller="Word" asp-action="Index">
                    <i class="bi bi-chat-square-quote-fill"></i> Words
                </a>
            </nav>

            <div class="admin-nav-label">Luyện tập</div>
            <nav class="admin-nav">
                <a class="nav-link @(Active("Exercise") || Active("Question") || Active("Answer") ? "active" : null)"
                   asp-area="Admin" asp-controller="Exercise" asp-action="Index">
                    <i class="bi bi-ui-checks"></i> Exercises
                </a>
                <a class="nav-link @(Active("ListeningLesson") || Active("ListeningQuestion") ? "active" : null)"
                   asp-area="Admin" asp-controller="ListeningLesson" asp-action="Index">
                    <i class="bi bi-headphones"></i> Listening
                </a>
                <a class="nav-link @(Active("Achievement") ? "active" : null)"
                   asp-area="Admin" asp-controller="Achievement" asp-action="Index">
                    <i class="bi bi-trophy-fill"></i> Achievements
                </a>
                <a class="nav-link @(Active("ReadingPassage") ? "active" : null)"
                   asp-area="Admin" asp-controller="ReadingPassage" asp-action="Index">
                    <i class="bi bi-journal-text"></i> Reading
                </a>
                <a class="nav-link @(Active("GrammarTopic") ? "active" : null)"
                   asp-area="Admin" asp-controller="GrammarTopic" asp-action="Index">
                    <i class="bi bi-spellcheck"></i> Grammar
                </a>
                <a class="nav-link @(Active("WritingPrompt") ? "active" : null)"
                   asp-area="Admin" asp-controller="WritingPrompt" asp-action="Index">
                    <i class="bi bi-pencil"></i> Writing
                </a>
                <a class="nav-link @(Active("PracticeAttempt") ? "active" : null)"
                   asp-area="Admin" asp-controller="PracticeAttempt" asp-action="Index">
                    <i class="bi bi-clipboard2-pulse"></i> Nói / Viết
                </a>
                <a class="nav-link @(Active("PlacementItem") ? "active" : null)"
                   asp-area="Admin" asp-controller="PlacementItem" asp-action="Index">
                    <i class="bi bi-clipboard-check"></i> Xếp lớp
                </a>
            </nav>

            <div class="admin-sidebar-foot">
                <a class="nav-link"
                   asp-area="Customer"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-box-arrow-up-right"></i> Về trang học
                </a>
                <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link w-100 text-start border-0 bg-transparent">
                        <i class="bi bi-power"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <div class="admin-frame">
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="admin-menu-btn" data-admin-toggle aria-label="Mở menu">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <div>
                        <p class="admin-topbar-title">@ViewData["Title"]</p>
                        <p class="admin-topbar-sub">@(ViewData["Subtitle"] ?? "Quản trị nội dung và tiến độ học")</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="admin-live">
                        <span class="admin-live-dot"></span>
                        <span id="adminClock">--:--</span>
                    </div>
                    <div class="admin-user-chip">
                        <span>@initial</span>
                        @displayName
                    </div>
                </div>
            </header>
            <main class="admin-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @if (TempData["success"] is string successMessage)
    {
        <script>
            Swal.fire({
                icon: "success",
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                timer: 1600,
                showConfirmButton: false
            });
        </script>
    }
    @if (TempData["error"] is string errorMessage)
    {
        <script>
            Swal.fire({
                icon: "error",
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage))
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
