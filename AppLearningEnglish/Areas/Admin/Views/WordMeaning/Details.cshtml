@model AppLearningEnglish.Models.WordMeaning
@{ ViewData["Title"] = "Meaning"; }
<div class="admin-form-banner tone-cyan">
    <div class="admin-form-icon"><i class="bi bi-translate"></i></div>
    <div>
        <h1 class="fw-bold">@(Model.Word?.WordText ?? "Meaning")</h1>
        <p>@Model.Language</p>
    </div>
</div>
<div class="card"><div class="card-body">
    <div class="admin-detail-panel mb-4"><h5 class="mb-0">@Model.Meaning</h5></div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="WordMeaning" asp-action="Upsert" asp-route-id="@Model.Id">Sửa</a>
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="WordMeaning" asp-action="Index">Quay lại</a>
    </div>
</div></div>
