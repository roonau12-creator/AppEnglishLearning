@{
    ViewData["Title"] = "Answers";
    ViewData["Subtitle"] = "Đáp án đúng / sai cho từng câu hỏi";
    ViewData["Icon"] = "bi-check2-square";
    ViewData["Tone"] = "mint";
    ViewData["ActionText"] = "Thêm Answer";
    ViewData["ActionController"] = "Answer";
}
<partial name="_AdminPageHead" />
<div class="admin-filter mb-4">
    <div class="admin-filter-label"><i class="bi bi-funnel"></i> Bộ lọc</div>
    <div class="row g-3">
        <div class="col-lg-5"><label class="form-label fw-semibold">Tìm kiếm</label><input id="searchInput" class="form-control" placeholder="Answer..." /></div>
        <div class="col-lg-5">
            <label class="form-label fw-semibold">Question</label>
            <select id="questionFilter" class="form-select">
                <option value="">Tất cả Question</option>
                @foreach (var question in ViewBag.Questions) { <option value="@question.Value">@question.Text</option> }
            </select>
        </div>
        <div class="col-lg-2 d-flex align-items-end"><button id="btnFilter" type="button" class="btn btn-dark w-100"><i class="bi bi-search"></i></button></div>
    </div>
</div>
<div class="card"><div class="card-header"><h5 class="mb-0 fw-bold">Danh sách Answers</h5></div>
<div class="card-body"><table id="answerTable" class="table table-hover align-middle w-100"><thead><tr><th>Question</th><th>Answer</th><th>Correct</th><th class="text-end">Action</th></tr></thead><tbody></tbody></table></div></div>
@section Scripts { <script src="~/js/answer.js"></script> }
