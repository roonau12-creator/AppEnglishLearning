@using System.Security.Claims
<ul class="navbar-nav align-items-center gap-2 ms-lg-3">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var displayName = User.FindFirstValue("FullName") ?? User.Identity?.Name;
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle me-1"></i>
                @displayName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-controller="Account" asp-action="Profile">
                        Hồ sơ
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-controller="Account" asp-action="ChangePassword">
                        Đổi mật khẩu
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="Identity"
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item">
                            Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-controller="Account"
               asp-action="Register">
                Đăng ký
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-nav-solid"
               asp-area="Identity"
               asp-controller="Account"
               asp-action="Login">
                Đăng nhập
            </a>
        </li>
    }
</ul>
